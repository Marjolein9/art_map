# Backend Environment Variables
# Copy this file to .env for local development
# For production (Render), set these in the dashboard

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================

# PostgreSQL Database URL (Production - Render/Heroku)
# Format: postgresql://user:password@host:port/database
# Render provides this automatically when you link a PostgreSQL database
DATABASE_URL=postgresql://localhost/artmap_dev

# SQLite Database Path (Local Development - fallback if DATABASE_URL not set)
# This is handled automatically by config.py

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================

# Port for Flask server (Render sets this automatically)
PORT=5000

# Debug mode - MUST be false in production!
# Values: true, false, 1, 0, yes, no
DEBUG=true

# =============================================================================
# CORS CONFIGURATION
# =============================================================================

# Allowed origins for CORS (comma-separated list)
# Examples:
#   - Local development: http://localhost:3000
#   - Production: https://art-map.vercel.app
#   - Multiple: https://art-map.vercel.app,https://art-map-preview.vercel.app
#   - Wildcard (dev only): *
ALLOWED_ORIGINS=http://localhost:3000

# =============================================================================
# IMAGE STORAGE (Optional - handled by config.py defaults)
# =============================================================================

# Base directory for images (auto-detected from config.py)
# Only set if you need a custom location
# IMAGES_DIR=/custom/path/to/images
